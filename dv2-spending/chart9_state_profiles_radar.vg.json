                  "k": 6
                },
                {
                  "measure": "share_Recreation",
                  "k": 7
                },
                {
                  "measure": "share_Eating out",
                  "k": 8
                }
              ]
            },
            "key": "measure",
            "fields": [
              "k"
            ]
          }
        },
        {
          "calculate": "datum.share * sin(datum.k * 2 * PI / 9)",
          "as": "px"
        },
        {
          "calculate": "datum.share * cos(datum.k * 2 * PI / 9)",
          "as": "py"
        },
        {
          "calculate": "datum.code == 'NT' ? 'Northern Territory' : datum.code == 'WA' ? 'Western Australia' : datum.code == 'VIC' ? 'Victoria' : 'Australia (average)'",
          "as": "area"
        },
        {
          "calculate": "replace(datum.measure, 'share_', '')",
          "as": "category"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 55
      },
      "encoding": {
