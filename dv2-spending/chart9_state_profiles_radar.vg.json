    {
      "description": "Closed shapes for the three states",
      "data": {
        "url": "data/states.csv"
      },
      "transform": [
        {
          "filter": {
            "field": "code",
            "oneOf": [
              "NT",
              "WA",
              "VIC",
              "AUS"
            ]
          }
        },
        {
          "fold": [
            "share_Food",
            "share_Health",
            "share_Transport",
            "share_Furnishings",
            "share_Clothing",
            "share_Miscellaneous",
            "share_Alcohol & tobacco",
            "share_Recreation",
            "share_Eating out"
          ],
          "as": [
            "measure",
            "share"
          ]
        },
        {
          "lookup": "measure",
          "from": {
            "data": {
              "values": [
                {
                  "measure": "share_Food",
                  "k": 0
                },
                {
                  "measure": "share_Health",
                  "k": 1
                },
                {
                  "measure": "share_Transport",
                  "k": 2
                },
                {
                  "measure": "share_Furnishings",
                  "k": 3
                },
                {
                  "measure": "share_Clothing",
                  "k": 4
                },
                {
                  "measure": "share_Miscellaneous",
                  "k": 5
                },
                {
                  "measure": "share_Alcohol & tobacco",
                  "k": 6
                },
                {
                  "measure": "share_Recreation",
                  "k": 7
                },
                {
                  "measure": "share_Eating out",
                  "k": 8
                }
              ]
            },
            "key": "measure",
            "fields": [
              "k"
            ]
          }
        },
        {
          "calculate": "datum.share * sin(datum.k * 2 * PI / 9)",
          "as": "px"
        },
        {
          "calculate": "datum.share * cos(datum.k * 2 * PI / 9)",
          "as": "py"
        },
        {
          "calculate": "datum.code == 'NT' ? 'Northern Territory' : datum.code == 'WA' ? 'Western Australia' : datum.code == 'VIC' ? 'Victoria' : 'Australia (average)'",
          "as": "area"
        },
        {
          "calculate": "replace(datum.measure, 'share_', '')",
          "as": "category"
        },
        {
          "filter": "datum.code != 'AUS'"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative",
          "scale": {
            "domain": [
              -27,
              27
            ],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "field": "py",
          "type": "quantitative",
          "scale": {
            "domain": [
              -27,
              27
            ],
            "nice": false
          },
          "axis": null
        },
        "order": {
          "field": "k",
          "type": "quantitative"
        },
        "color": {
          "field": "area",
          "type": "nominal",
          "scale": {
            "domain": [
              "Northern Territory",
              "Western Australia",
              "Victoria",
              "Australia (average)"
            ],
            "range": [
              "#851025",
              "#228893",
              "#313499",
              "#333333"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": null,
            "symbolStrokeWidth": 3,
            "symbolSize": 200,
            "labelFontSize": 12
          }
        },
        "opacity": {
          "condition": {
            "param": "pick_area",
            "value": 1
          },
          "value": 0.15
        }
      }
    },
