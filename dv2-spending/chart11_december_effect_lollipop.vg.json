{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": { "step": 34 },
  "title": {
    "text": [
      "December spending is far above an average month for clothing,",
      "alcohol and furnishings, but below it for health and transport"
    ],
    "subtitle": [
      "December spending compared with an average month, for each of nine categories.",
      "Average of 2023, 2024 and 2025; every category moved the same way in all three years.",
      "This is the seasonal pattern that seasonally adjusted figures remove. Dashed line: all tracked spending."
    ],
    "offset": 30
  },
  "config": {
    "font": "Arial, Helvetica, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#444444",
      "titleColor": "#444444",
      "gridColor": "#e8e8e8",
      "domainColor": "#999999",
      "tickColor": "#999999"
    },
    "title": {
      "anchor": "start",
      "fontSize": 18,
      "subtitleFontSize": 12,
      "subtitleColor": "#555555",
      "subtitlePadding": 6,
      "offset": 14
    }
  },
  "data": { "url": "data/december_effect.csv" },
  "transform": [
    { "calculate": "(datum.dec_effect_pct >= 0 ? '+' : '') + format(datum.dec_effect_pct, '.1f') + '%'", "as": "label" },
    { "calculate": "0", "as": "zero" }
  ],
  "layer": [
    {
      "description": "Zero line (an average month)",
      "data": { "values": [{ "zero": 0 }] },
      "mark": { "type": "rule", "color": "#333333", "strokeWidth": 1 },
      "encoding": {
        "x": { "field": "zero", "type": "quantitative", "scale": { "domain": [-12, 48], "nice": false }, "axis": null }
      }
    },
    {
      "description": "Dashed line for all tracked spending",
      "transform": [{ "filter": "datum.category == 'All tracked spending'" }],
      "mark": { "type": "rule", "color": "#333333", "strokeWidth": 1.5, "strokeDash": [5, 4] },
      "encoding": {
        "x": {
          "field": "dec_effect_pct",
          "type": "quantitative",
          "scale": { "domain": [-12, 48], "nice": false },
          "title": null,
          "axis": null
        },
        "tooltip": [
          { "field": "category", "type": "nominal", "title": "Measure" },
          {
            "field": "dec_effect_pct",
            "type": "quantitative",
            "title": "December vs an average month (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "description": "Stems from zero to the December effect",
      "transform": [{ "filter": "datum.category != 'All tracked spending'" }],
      "mark": { "type": "rule", "strokeWidth": 3 },
      "encoding": {
        "x": {
          "field": "dec_effect_pct",
          "type": "quantitative",
          "scale": { "domain": [-12, 48], "nice": false },
          "title": null,
          "axis": {
            "values": [-10, 0, 10, 20, 30, 40],
            "labelExpr": "datum.value > 0 ? '+' + datum.value + '%' : datum.value + '%'",
            "grid": true,
            "domain": false
          }
        },
        "x2": { "field": "zero" },
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": { "field": "dec_effect_pct", "op": "max", "order": "descending" },
          "title": null,
          "axis": { "domain": false, "ticks": false, "labelPadding": 10, "labelLimit": 160 }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Food",
              "Alcohol & tobacco",
              "Clothing",
              "Furnishings",
              "Health",
              "Transport",
              "Recreation",
              "Eating out",
              "Miscellaneous"
            ],
            "range": ["#f28c1e", "#5f8a1c", "#ae8e5f", "#53b7f3", "#1fa58e", "#1197fd", "#9014a2", "#74d8e3", "#9dd6ae"]
          },
          "legend": null
        }
      }
    },
    {
      "description": "Dots at the end of each stem",
      "transform": [{ "filter": "datum.category != 'All tracked spending'" }],
      "mark": { "type": "circle", "size": 190, "opacity": 1, "stroke": "#444444", "strokeWidth": 0.8 },
      "encoding": {
        "x": {
          "field": "dec_effect_pct",
          "type": "quantitative",
          "scale": { "domain": [-12, 48], "nice": false },
          "title": null,
          "axis": null
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": { "field": "dec_effect_pct", "op": "max", "order": "descending" },
          "title": null,
          "axis": { "domain": false, "ticks": false, "labelPadding": 10, "labelLimit": 160 }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Food",
              "Alcohol & tobacco",
              "Clothing",
              "Furnishings",
              "Health",
              "Transport",
              "Recreation",
              "Eating out",
              "Miscellaneous"
            ],
            "range": ["#f28c1e", "#5f8a1c", "#ae8e5f", "#53b7f3", "#1fa58e", "#1197fd", "#9014a2", "#74d8e3", "#9dd6ae"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "category", "type": "nominal", "title": "Category" },
          {
            "field": "dec_effect_pct",
            "type": "quantitative",
            "title": "December vs an average month (%)",
            "format": "+.1f"
          },
          { "field": "y2023", "type": "quantitative", "title": "December 2023 (%)", "format": "+.1f" },
          { "field": "y2024", "type": "quantitative", "title": "December 2024 (%)", "format": "+.1f" },
          { "field": "y2025", "type": "quantitative", "title": "December 2025 (%)", "format": "+.1f" },
          {
            "field": "avg_december_m",
            "type": "quantitative",
            "title": "Average December spending ($ million)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "description": "Value labels above the average month",
      "transform": [{ "filter": "datum.category != 'All tracked spending'" }, { "filter": "datum.dec_effect_pct >= 0" }],
      "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 12, "fontSize": 12, "color": "#222222" },
      "encoding": {
        "x": {
          "field": "dec_effect_pct",
          "type": "quantitative",
          "scale": { "domain": [-12, 48], "nice": false },
          "title": null,
          "axis": null
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": { "field": "dec_effect_pct", "op": "max", "order": "descending" },
          "title": null,
          "axis": { "domain": false, "ticks": false, "labelPadding": 10, "labelLimit": 160 }
        },
        "text": { "field": "label" }
      }
    },
    {
      "description": "Value labels below the average month",
      "transform": [{ "filter": "datum.category != 'All tracked spending'" }, { "filter": "datum.dec_effect_pct < 0" }],
      "mark": { "type": "text", "align": "right", "baseline": "middle", "dx": -12, "fontSize": 12, "color": "#222222" },
      "encoding": {
        "x": {
          "field": "dec_effect_pct",
          "type": "quantitative",
          "scale": { "domain": [-12, 48], "nice": false },
          "title": null,
          "axis": null
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": { "field": "dec_effect_pct", "op": "max", "order": "descending" },
          "title": null,
          "axis": { "domain": false, "ticks": false, "labelPadding": 10, "labelLimit": 160 }
        },
        "text": { "field": "label" }
      }
    },
    {
      "description": "Label for the dashed line",
      "transform": [
        { "filter": "datum.category == 'All tracked spending'" },
        { "calculate": "'All tracked spending: ' + datum.label", "as": "ref_text" }
      ],
      "mark": { "type": "text", "align": "right", "baseline": "bottom", "dx": -6, "fontSize": 11, "color": "#333333" },
      "encoding": {
        "x": {
          "field": "dec_effect_pct",
          "type": "quantitative",
          "scale": { "domain": [-12, 48], "nice": false },
          "title": null,
          "axis": null
        },
        "y": { "value": -6 },
        "text": { "field": "ref_text", "type": "nominal" }
      }
    }
  ]
}